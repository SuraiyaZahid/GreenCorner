# GreenCorner — environment file
#
# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# The .env file holds the database password, so it is NOT tracked in version
# control. The tracked config/config.php carries no password at all: a
# missing credential is a fatal error with a clear message, never a silent
# fallback (decision D-001).
#
# In production the password comes from the deployment secret store, not from
# a file on disk.

# ---------------------------------------------------------------------------
# The database
# ---------------------------------------------------------------------------

# The name of the database.
DB_NAME=greencorner

# The database account the application uses. It needs SELECT, INSERT,
# UPDATE and DELETE, and it needs to be able to create the schema in
# development.
DB_USER=greencorner

# The database password. THIS IS THE SECRET. Replace it before starting the
# container. The compose file refuses to start without it.
DB_PASS=change-me-before-deploying

# ---------------------------------------------------------------------------
# The application
# ---------------------------------------------------------------------------

# 'production' or 'development'. In production the Secure session cookie flag
# is set and the sample-data seed refuses to run (SC-16).
APP_ENV=production

# The address the application is served on. It is used to build the links in
# the pages and to point the front-end JavaScript at the right base URL.
GREEN_CORNER_URL=http://127.0.0.1:8080
